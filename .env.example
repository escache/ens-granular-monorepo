# ENS Granular monorepo environment variables

# Network
RPC_URL=https://eth.llamarpc.com
NETWORK=mainnet
CHAIN_ID=1
PRIVATE_KEY=0x...

# ENS contracts (mainnet defaults)
ENS_REGISTRY=0x00000000000C2E074eC69A0dFb2997BA6C7d2e1e
NAME_WRAPPER=0xD4416b13d2b3a9aBae7AcD5D6C2BbDBE25686401

# Deployed ENS Granular contracts (set after deployment)
FACTORY_ADDRESS=
DELEGATE_ADDRESS=
GRANULAR_DELEGATE_ADDRESS=

# UI (Vite) — set in packages/ui/.env.local
# VITE_FACTORY_ADDRESS_MAINNET=
# VITE_FACTORY_ADDRESS_SEPOLIA=
# VITE_GRANULAR_RESOLVER_MAINNET=
# VITE_GRANULAR_RESOLVER_SEPOLIA=
